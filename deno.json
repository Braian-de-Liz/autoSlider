{
  "name": "auto-slider",
  "version": "0.1.0",
  "exports": "./src/desktop/main.ts",
  "tasks": {
    "desktop:dev": "deno desktop --hmr src/desktop/main.ts",
    "desktop:build": "deno desktop --backend webview --allow-net --allow-env --allow-sys --allow-read --allow-write --allow-ffi --include assets/fonts --output ./dist/autoSlider src/desktop/main.ts",
    "desktop:server": "deno run --allow-net --allow-env src/desktop/main.ts",
    "desktop:webview": "deno run --allow-all src/desktop/webview-main.ts",
    "test": "deno test --allow-read --allow-env --allow-net --allow-ffi --allow-sys --allow-write tests/"
  },
  "imports": {
    "bun:test": "./tests/support/bun-test-shim.ts",
    "@std/testing/bdd": "jsr:@std/testing@1.0.17/bdd",
    "@std/expect": "jsr:@std/expect@1.0.17",
    "hono": "npm:hono@4.7.2",
    "ai": "npm:ai@7.0.135",
    "@ai-sdk/provider-utils": "npm:@ai-sdk/provider-utils@5.0.58",
    "@ai-sdk/openai-compatible": "npm:@ai-sdk/openai-compatible@3.0.67",
    "ollama-ai-provider-v2": "npm:ollama-ai-provider-v2@4.0.1",
    "@sinclair/typebox": "npm:@sinclair/typebox@0.34.41",
    "@sinclair/typebox/compiler": "npm:@sinclair/typebox@0.34.41/compiler",
    "@resvg/resvg-wasm": "npm:@resvg/resvg-wasm@2.6.2",
    "vega": "npm:vega@6.4.0",
    "docx": "npm:docx@9.9.0",
    "vega-lite": "npm:vega-lite@6.5.0",
    "@webview/webview": "jsr:@webview/webview@0.9.0"
  },
  "desktop": {
    "app": {
      "name": "Gerador de Artefatos",
      "identifier": "com.braian.geradordeartefatos"
    },
    "backend": "webview",
    "output": {
      "windows": "./dist/autoSlider"
    }
  }
}
