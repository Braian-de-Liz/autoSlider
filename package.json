{
  "name": "auto-slider",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "test:deno": "deno task test",
    "test:all": "bun test && deno task test",
    "trace": "bun run scripts/trace.ts",
    "fixtures": "bun run scripts/make-fixtures.ts",
    "check": "bun run typecheck && bun run test:all && bun run trace",
    "typecheck": "tsc --noEmit",
    "probe": "bun run src/cli.ts probe --schema chart",
    "desktop": "deno run --allow-all src/desktop/webview-main.ts",
    "desktop:bun": "bun run src/desktop/main.ts",
    "desktop:deno": "deno desktop --backend webview --allow-net --allow-env --allow-sys --allow-read --allow-write --allow-ffi --include assets/fonts src/desktop/main.ts",
    "desktop:run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-deno.ps1",
    "desktop:run:fonte": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-deno.ps1 -Modo Fonte"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.67",
    "@ai-sdk/provider-utils": "5.0.58",
    "@resvg/resvg-wasm": "2.6.2",
    "@sinclair/typebox": "0.34.41",
    "ai": "7.0.135",
    "docx": "9.9.0",
    "hono": "4.7.2",
    "ollama-ai-provider-v2": "4.0.1",
    "vega": "6.4.0",
    "vega-lite": "6.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  }
}
