LLM_PROVIDER=ollama-native
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
LLM_API_KEY=
LLM_NUM_CTX=8192
LLM_TIMEOUT_MS=120000

# Projeto. Com PROJECT_LOCAL_ONLY=true (padrão), provedor remoto termina em E_LOCAL_ONLY sem enviar nada.
PROJECT_NAME=Meu projeto
PROJECT_LOCAL_ONLY=true

# OpenRouter: altere estas variáveis e defina PROJECT_LOCAL_ONLY=false para o probe remoto
# LLM_PROVIDER=openai-compat
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=provider/model
# LLM_API_KEY=replace-me
